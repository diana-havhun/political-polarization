## 8      NA  1750</code></pre>
<pre class="r"><code>data_model &lt;- data_clean %&gt;%
  mutate(party = case_when(
    partyid %in% c(1, 2, 3) ~ &quot;Democrat&quot;,
    partyid %in% c(5, 6, 7) ~ &quot;Republican&quot;,
    TRUE ~ NA_character_
  )) %&gt;%
  filter(!is.na(party)) %&gt;%
  mutate(party = as.factor(party))</code></pre>
<pre class="r"><code>data_model &lt;- data_model %&gt;%
  mutate(
    decade = case_when(
      year &lt; 1960  ~ &quot;1950s&quot;,
      year &lt; 1970  ~ &quot;1960s&quot;,
      year &lt; 1980  ~ &quot;1970s&quot;,
      year &lt; 1990  ~ &quot;1980s&quot;,
      year &lt; 2000  ~ &quot;1990s&quot;,
      year &lt; 2010  ~ &quot;2000s&quot;,
      year &lt; 2020  ~ &quot;2010s&quot;,
      year &gt;= 2020 ~ &quot;2020s&quot;
    ),
    
    # Factor labels for demographics
    gender = factor(gender, levels = c(1, 2), labels = c(&quot;Male&quot;, &quot;Female&quot;)),
    race = factor(race, levels = c(1, 2, 3, 4, 5, 6),
              labels = c(&quot;White&quot;, &quot;Black&quot;, &quot;Asian/PI&quot;, 
                         &quot;Native American&quot;, &quot;Hispanic&quot;, &quot;Other&quot;)),
    education = factor(education, levels = c(1, 2, 3, 4),
                       labels = c(&quot;&lt; High School&quot;, &quot;High School&quot;, 
                                  &quot;Some College&quot;, &quot;College+&quot;)),
    region = factor(region, levels = c(1, 2, 3, 4),
                    labels = c(&quot;Northeast&quot;, &quot;Midwest&quot;, &quot;South&quot;, &quot;West&quot;)),
    religion = factor(religion, levels = c(1, 2, 3, 4),
                      labels = c(&quot;Protestant&quot;, &quot;Catholic&quot;, &quot;Jewish&quot;, &quot;Other/None&quot;))
  )</code></pre>
</div>
<div id="exploratory-data-analysis" class="section level1">
<h1>Exploratory Data Analysis</h1>
<p>Before turning to the machine learning models, we first examine
descriptive trends in party identification and demographic sorting.
These patterns provide important context for understanding what the
models are trying to predict, and why we might expect their accuracy to
change over time.</p>
<pre class="r"><code>party_colors &lt;- c(&quot;Democrat&quot; = &quot;#2171b5&quot;, &quot;Republican&quot; = &quot;#cb181d&quot;)

theme_party &lt;- theme_minimal() +
  theme(
    plot.title = element_text(face = &quot;bold&quot;, size = 14),
    plot.subtitle = element_text(color = &quot;gray40&quot;, size = 10),
    legend.position = &quot;bottom&quot;
  )

# calculate party % by group over time
calc_party_pct &lt;- function(data, group_var, group_value) {
  data %&gt;%
    filter(!is.na(party), !!sym(group_var) == group_value) %&gt;%
    mutate(period = floor(year / 10) * 10) %&gt;%
    group_by(period, party) %&gt;%
    summarise(n = n(), .groups = &quot;drop&quot;) %&gt;%
    group_by(period) %&gt;%
    mutate(pct = n / sum(n) * 100)
}</code></pre>
<pre class="r"><code>party_overall &lt;- data_model %&gt;%
  filter(!is.na(party)) %&gt;%
  mutate(period = floor(year / 4) * 4) %&gt;%
  group_by(period, party) %&gt;%
  summarise(n = n(), .groups = &quot;drop&quot;) %&gt;%
  group_by(period) %&gt;%
  mutate(pct = n / sum(n) * 100)

ggplot(party_overall, aes(x = period, y = pct, color = party)) +
  geom_line(linewidth = 1.2) +
  geom_point(size = 2.5) +
  scale_color_manual(values = party_colors) +
  scale_y_continuous(labels = function(x) paste0(x, &quot;%&quot;), limits = c(30, 70)) +
  geom_hline(yintercept = 50, linetype = &quot;dashed&quot;, color = &quot;gray50&quot;, alpha = 0.5) +
  labs(title = &quot;Party Identification Over Time&quot;,
       subtitle = &quot;Among respondents identifying as Democrat or Republican (excluding Independents)&quot;,
       x = &quot;&quot;, y = &quot;% of respondents&quot;, color = &quot;&quot;) +
  theme_party</code></pre>
<p><img role="img" src="data:image/png;base64," width="672" /></p>
<p>The overall trend in party identification shows a substantial
Democratic advantage through the 1950s–1970s, reflecting the post-New
Deal coalition that dominated American politics for much of the
twentieth century. The gap has narrowed considerably since the 1980s,
with parties approaching near-parity in the 2020s, consistent with the
nationalization of American politics documented by <span class="citation">Abramowitz and Saunders (2008)</span>, as national
partisan identity has grown stronger, the old regional and class-based
coalitions that sustained Democratic dominance have gradually
eroded.</p>
<p>How have different demographic groups changed over time? We look at
party affiliation based on six key factors: <strong>education, gender,
income, religion, church attendance, region, and marital
status</strong>. These patterns reveal which demographic divides have
become stronger or weaker in partisan politics.</p>
<pre class="r"><code>data_edu &lt;- data_model %&gt;%
  filter(!is.na(education), !is.na(party)) %&gt;%
  mutate(edu_group = case_when(
    education %in% c(&quot;Some College&quot;, &quot;College+&quot;) ~ &quot;College or higher&quot;,
    TRUE ~ &quot;No college degree&quot;
  ))

p_college &lt;- calc_party_pct(data_edu, &quot;edu_group&quot;, &quot;College or higher&quot;)
g_college &lt;- ggplot(p_college, aes(x = period, y = pct, color = party)) +
  geom_line(linewidth = 1.2) + geom_point(size = 2) +
  scale_color_manual(values = party_colors) +
  scale_y_continuous(labels = function(x) paste0(x, &quot;%&quot;), limits = c(25, 75)) +
  geom_hline(yintercept = 50, linetype = &quot;dashed&quot;, color = &quot;gray50&quot;, alpha = 0.5) +
  labs(title = &quot;College or Higher&quot;, x = &quot;&quot;, y = &quot;% of group&quot;, color = &quot;&quot;) +
  theme_party

p_nocollege &lt;- calc_party_pct(data_edu, &quot;edu_group&quot;, &quot;No college degree&quot;)
g_nocollege &lt;- ggplot(p_nocollege, aes(x = period, y = pct, color = party)) +
  geom_line(linewidth = 1.2) + geom_point(size = 2) +
  scale_color_manual(values = party_colors) +
  scale_y_continuous(labels = function(x) paste0(x, &quot;%&quot;), limits = c(25, 75)) +
  geom_hline(yintercept = 50, linetype = &quot;dashed&quot;, color = &quot;gray50&quot;, alpha = 0.5) +
  labs(title = &quot;No College Degree&quot;, x = &quot;&quot;, y = &quot;% of group&quot;, color = &quot;&quot;) +
  theme_party

grid.arrange(g_college, g_nocollege, ncol = 2,
             top = grid::textGrob(&quot;Party Affiliation by Education Over Time&quot;,
                                  gp = grid::gpar(fontsize = 16, fontface = &quot;bold&quot;)))</code></pre>
<p><img role="img" src="data:image/png;base64," width="672" /></p>
<p>The education reversal is a significant change in American politics.
College-educated voters, who used to mostly support Republicans, have
increasingly leaned toward Democrats since the 1990s. In contrast,
non-college-educated voters have shifted the other way. This growing
divide based on education has been widely studied <span class="citation">(Abramowitz and Saunders 2008; Ojer et al. 2025)</span>
and became especially noticeable between 2010 and 2020.</p>
<pre class="r"><code>p_female &lt;- calc_party_pct(data_model, &quot;gender&quot;, &quot;Female&quot;)
g_female &lt;- ggplot(p_female, aes(x = period, y = pct, color = party)) +
  geom_line(linewidth = 1.2) + geom_point(size = 2) +
  scale_color_manual(values = party_colors) +
  scale_y_continuous(labels = function(x) paste0(x, &quot;%&quot;), limits = c(25, 75)) +
  geom_hline(yintercept = 50, linetype = &quot;dashed&quot;, color = &quot;gray50&quot;, alpha = 0.5) +
  labs(title = &quot;Female&quot;, x = &quot;&quot;, y = &quot;% of group&quot;, color = &quot;&quot;) +
  theme_party

p_male &lt;- calc_party_pct(data_model, &quot;gender&quot;, &quot;Male&quot;)
g_male &lt;- ggplot(p_male, aes(x = period, y = pct, color = party)) +
  geom_line(linewidth = 1.2) + geom_point(size = 2) +
  scale_color_manual(values = party_colors) +
  scale_y_continuous(labels = function(x) paste0(x, &quot;%&quot;), limits = c(25, 75)) +
  geom_hline(yintercept = 50, linetype = &quot;dashed&quot;, color = &quot;gray50&quot;, alpha = 0.5) +
  labs(title = &quot;Male&quot;, x = &quot;&quot;, y = &quot;% of group&quot;, color = &quot;&quot;) +
  theme_party

grid.arrange(g_female, g_male, ncol = 2,
             top = grid::textGrob(&quot;Party Affiliation by Sex Over Time&quot;,
                                  gp = grid::gpar(fontsize = 16, fontface = &quot;bold&quot;)))</code></pre>
<p><img role="img" src="data:image/png;base64," width="672" /></p>
<p>The gender gap in partisanship, while modest in the 1950s–1960s, has
grown over time. Women have consistently leaned more Democratic than men
since the 1980s, a pattern linked to diverging views on social issues,
reproductive rights, and the role of government <span class="citation">(Mason 2018)</span>.</p>
<pre class="r"><code>data_income &lt;- data_model %&gt;%
  filter(!is.na(income), !is.na(party)) %&gt;%
  mutate(income_group = case_when(
    income %in% c(1, 2) ~ &quot;Low income&quot;,
    income == 3          ~ &quot;Middle income&quot;,
    income %in% c(4, 5) ~ &quot;High income&quot;
  ))

p_low &lt;- calc_party_pct(data_income, &quot;income_group&quot;, &quot;Low income&quot;)
g_low &lt;- ggplot(p_low, aes(x = period, y = pct, color = party)) +
  geom_line(linewidth = 1.2) + geom_point(size = 2) +
  scale_color_manual(values = party_colors) +
  scale_y_continuous(labels = function(x) paste0(x, &quot;%&quot;), limits = c(25, 75)) +
  geom_hline(yintercept = 50, linetype = &quot;dashed&quot;, color = &quot;gray50&quot;, alpha = 0.5) +
  labs(title = &quot;Low Income&quot;, x = &quot;&quot;, y = &quot;% of group&quot;, color = &quot;&quot;) +
  theme_party

p_high &lt;- calc_party_pct(data_income, &quot;income_group&quot;, &quot;High income&quot;)
g_high &lt;- ggplot(p_high, aes(x = period, y = pct, color = party)) +
  geom_line(linewidth = 1.2) + geom_point(size = 2) +
  scale_color_manual(values = party_colors) +
  scale_y_continuous(labels = function(x) paste0(x, &quot;%&quot;), limits = c(25, 75)) +
  geom_hline(yintercept = 50, linetype = &quot;dashed&quot;, color = &quot;gray50&quot;, alpha = 0.5) +
  labs(title = &quot;High Income&quot;, x = &quot;&quot;, y = &quot;% of group&quot;, color = &quot;&quot;) +
  theme_party

grid.arrange(g_low, g_high, ncol = 2,
             top = grid::textGrob(&quot;Party Affiliation by Income Over Time&quot;,
                                  gp = grid::gpar(fontsize = 16, fontface = &quot;bold&quot;)))</code></pre>
<p><img role="img" src="data:image/png;base64," width="672" /></p>
<p>Low-income voters have typically supported Democrats, but since 2000,
that support has decreased and nearly equalized by the 2020s.
Conversely, high-income voters have shifted from a strong Republican
preference to a more balanced support between the parties. Overall,
income is becoming less important in predicting political party
affiliation.</p>
<pre class="r"><code># Party Affiliation by Religion
relig_party &lt;- data_model %&gt;%
  filter(!is.na(religion), !is.na(party)) %&gt;%
  group_by(religion, party) %&gt;%
  summarise(n = n(), .groups = &quot;drop&quot;) %&gt;%
  group_by(religion) %&gt;%
  mutate(pct = n / sum(n) * 100,
         total = sum(n)) %&gt;%
  ungroup()

ggplot(relig_party, aes(x = reorder(religion, pct * ifelse(party == &quot;Republican&quot;, 1, -1)),
                        y = pct, fill = party)) +
  geom_bar(stat = &quot;identity&quot;, position = &quot;stack&quot;, width = 0.7) +
  scale_fill_manual(values = c(&quot;Democrat&quot; = &quot;#2171b5&quot;, &quot;Republican&quot; = &quot;#cb181d&quot;)) +
  scale_y_continuous(labels = function(x) paste0(x, &quot;%&quot;)) +
  geom_hline(yintercept = 50, linetype = &quot;dashed&quot;, color = &quot;white&quot;, linewidth = 0.8) +
  coord_flip() +
  labs(title = &quot;Party Affiliation by Religion&quot;,
       subtitle = &quot;Dashed line = 50/50 split.&quot;,
       x = &quot;&quot;, y = &quot;% of respondents within religion&quot;, fill = &quot;&quot;) +
  theme_minimal() +
  theme(plot.title = element_text(face = &quot;bold&quot;, size = 14),
        plot.subtitle = element_text(color = &quot;gray40&quot;, size = 10),
        legend.position = &quot;bottom&quot;)</code></pre>
<p><img role="img" src="data:image/png;base64," width="672" /></p>
<pre class="r"><code># Religion over time — Protestant vs Catholic vs Jewish vs Other/None
p_protestant &lt;- calc_party_pct(data_model, &quot;religion&quot;, &quot;Protestant&quot;)
g_protestant &lt;- ggplot(p_protestant, aes(x = period, y = pct, color = party)) +
  geom_line(linewidth = 1.2) + geom_point(size = 2) +
  scale_color_manual(values = party_colors) +
  scale_y_continuous(labels = function(x) paste0(x, &quot;%&quot;), limits = c(20, 80)) +
  geom_hline(yintercept = 50, linetype = &quot;dashed&quot;, color = &quot;gray50&quot;, alpha = 0.5) +
  labs(title = &quot;Protestant&quot;, x = &quot;&quot;, y = &quot;% of group&quot;, color = &quot;&quot;) +
  theme_party

p_catholic &lt;- calc_party_pct(data_model, &quot;religion&quot;, &quot;Catholic&quot;)
g_catholic &lt;- ggplot(p_catholic, aes(x = period, y = pct, color = party)) +
  geom_line(linewidth = 1.2) + geom_point(size = 2) +
  scale_color_manual(values = party_colors) +
  scale_y_continuous(labels = function(x) paste0(x, &quot;%&quot;), limits = c(20, 80)) +
  geom_hline(yintercept = 50, linetype = &quot;dashed&quot;, color = &quot;gray50&quot;, alpha = 0.5) +
  labs(title = &quot;Catholic&quot;, x = &quot;&quot;, y = &quot;% of group&quot;, color = &quot;&quot;) +
  theme_party

p_jewish &lt;- calc_party_pct(data_model, &quot;religion&quot;, &quot;Jewish&quot;)
g_jewish &lt;- ggplot(p_jewish, aes(x = period, y = pct, color = party)) +
  geom_line(linewidth = 1.2) + geom_point(size = 2) +
  scale_color_manual(values = party_colors) +
  scale_y_continuous(labels = function(x) paste0(x, &quot;%&quot;), limits = c(0, 100)) +
  geom_hline(yintercept = 50, linetype = &quot;dashed&quot;, color = &quot;gray50&quot;, alpha = 0.5) +
  labs(title = &quot;Jewish&quot;, x = &quot;&quot;, y = &quot;% of group&quot;, color = &quot;&quot;) +
  theme_party

p_other &lt;- calc_party_pct(data_model, &quot;religion&quot;, &quot;Other/None&quot;)
g_other &lt;- ggplot(p_other, aes(x = period, y = pct, color = party)) +
  geom_line(linewidth = 1.2) + geom_point(size = 2) +
  scale_color_manual(values = party_colors) +
  scale_y_continuous(labels = function(x) paste0(x, &quot;%&quot;), limits = c(0, 100)) +
  geom_hline(yintercept = 50, linetype = &quot;dashed&quot;, color = &quot;gray50&quot;, alpha = 0.5) +
  labs(title = &quot;Other / None&quot;, x = &quot;&quot;, y = &quot;% of group&quot;, color = &quot;&quot;) +
  theme_party

grid.arrange(g_protestant, g_catholic, g_jewish, g_other, ncol = 2, nrow = 2,
             top = grid::textGrob(&quot;Party Affiliation by Religion Over Time&quot;,
                                  gp = grid::gpar(fontsize = 16, fontface = &quot;bold&quot;)))</code></pre>
<p><img role="img" src="data:image/png;base64," width="672" /></p>
<p>Religion is a key factor in how people vote. Many white Protestants
and more Catholics are leaning Republican, reflecting the “culture war”
sorting described by <span class="citation">Baldassarri and Gelman
(2008)</span> and <span class="citation">Murphy and Zhirnov
(2020)</span>, while Jewish voters and those without religious ties
mostly support Democrats. The number of religiously unaffiliated voters,
often called “nones,” has increased, leading to a growing divide between
religious and non-religious voters since the 1990s.</p>
<pre class="r"><code># VCF0130: 1=Every week, 2=Almost every week, 3=Once/twice a month, 4=A few times a year, 5=Never, 7=No religious preference
data_church &lt;- data_model %&gt;%
  filter(!is.na(church), !is.na(party)) %&gt;%
  mutate(church_group = case_when(
    church %in% c(1, 2) ~ &quot;Weekly/Almost weekly&quot;,
    church %in% c(3, 4) ~ &quot;Sometimes&quot;,
    church %in% c(5, 7) ~ &quot;Rarely/Never&quot;
  ))

p_weekly &lt;- calc_party_pct(data_church, &quot;church_group&quot;, &quot;Weekly/Almost weekly&quot;)
g_weekly &lt;- ggplot(p_weekly, aes(x = period, y = pct, color = party)) +
  geom_line(linewidth = 1.2) + geom_point(size = 2) +
  scale_color_manual(values = party_colors) +
  scale_y_continuous(labels = function(x) paste0(x, &quot;%&quot;), limits = c(25, 75)) +
  geom_hline(yintercept = 50, linetype = &quot;dashed&quot;, color = &quot;gray50&quot;, alpha = 0.5) +
  labs(title = &quot;Weekly / Almost Weekly&quot;, x = &quot;&quot;, y = &quot;% of group&quot;, color = &quot;&quot;) +
  theme_party

p_never &lt;- calc_party_pct(data_church, &quot;church_group&quot;, &quot;Rarely/Never&quot;)
g_never &lt;- ggplot(p_never, aes(x = period, y = pct, color = party)) +
  geom_line(linewidth = 1.2) + geom_point(size = 2) +
  scale_color_manual(values = party_colors) +
  scale_y_continuous(labels = function(x) paste0(x, &quot;%&quot;), limits = c(25, 75)) +
  geom_hline(yintercept = 50, linetype = &quot;dashed&quot;, color = &quot;gray50&quot;, alpha = 0.5) +
  labs(title = &quot;Rarely / Never&quot;, x = &quot;&quot;, y = &quot;% of group&quot;, color = &quot;&quot;) +
  theme_party

grid.arrange(g_weekly, g_never, ncol = 2,
             top = grid::textGrob(&quot;Party Affiliation by Church Attendance Over Time&quot;,
                                  gp = grid::gpar(fontsize = 16, fontface = &quot;bold&quot;)))</code></pre>
<p><img role="img" src="data:image/png;base64," width="672" /></p>
<p>Church attendance has become a strong indicator of whether someone
identifies as a Republican. Since the 1970s, people who attend church
weekly have increasingly leaned toward the GOP, especially in the 1990s
with the rise of the Christian right. In contrast, those who rarely or
never attend church have shifted away from the Republican Party,
widening the gap based on religious attendance.</p>
<pre class="r"><code># VCF0147: 1=Married, 2=Never married, 3=Divorced, 4=Separated, 5=Widowed, 7=Partners
data_marital &lt;- data_model %&gt;%
  filter(!is.na(marital), !is.na(party)) %&gt;%
  mutate(marital_group = case_when(
    marital == 1 ~ &quot;Married&quot;,
    marital == 2 ~ &quot;Never married&quot;,
    marital %in% c(3, 4) ~ &quot;Divorced/Separated&quot;,
    marital == 5 ~ &quot;Widowed&quot;,
    marital == 7 ~ &quot;Partners (not married)&quot;
  ))


marital_party &lt;- data_marital %&gt;%
  group_by(marital_group, party) %&gt;%
  summarise(n = n(), .groups = &quot;drop&quot;) %&gt;%
  group_by(marital_group) %&gt;%
  mutate(pct = n / sum(n) * 100, total = sum(n)) %&gt;%
  filter(total &gt;= 100) %&gt;%
  ungroup()

ggplot(marital_party, aes(x = reorder(marital_group, pct * ifelse(party == &quot;Republican&quot;, 1, -1)),
                          y = pct, fill = party)) +
  geom_bar(stat = &quot;identity&quot;, position = &quot;stack&quot;, width = 0.7) +
  scale_fill_manual(values = c(&quot;Democrat&quot; = &quot;#2171b5&quot;, &quot;Republican&quot; = &quot;#cb181d&quot;)) +
  scale_y_continuous(labels = function(x) paste0(x, &quot;%&quot;)) +
  geom_hline(yintercept = 50, linetype = &quot;dashed&quot;, color = &quot;white&quot;, linewidth = 0.8) +
  coord_flip() +
  labs(title = &quot;Party Affiliation by Marital Status&quot;,
       subtitle = &quot;Dashed line = 50/50 split.&quot;,
       x = &quot;&quot;, y = &quot;% of respondents within group&quot;, fill = &quot;&quot;) +
  theme_minimal() +
  theme(plot.title = element_text(face = &quot;bold&quot;, size = 14),
        plot.subtitle = element_text(color = &quot;gray40&quot;, size = 10),
        legend.position = &quot;bottom&quot;)</code></pre>
<p><img role="img" src="data:image/png;base64," width="672" /></p>
<p>Marital status shows some differences in political views. Married
people tend to favor Republicans a bit, while those who are never
married or living together lean more towards Democrats. However, these
differences aren’t very significant, and marital status is not a major
factor in predicting political preferences.</p>

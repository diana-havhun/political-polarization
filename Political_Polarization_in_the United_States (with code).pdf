log_att_prob_20 &lt;- predict(log_att_20, test_att_20, type = &quot;response&quot;)
log_att_pred_20 &lt;- factor(ifelse(log_att_prob_20 &gt; 0.5, &quot;Republican&quot;, &quot;Democrat&quot;),
                          levels = levels(test_att_20$party))

# RF attitudes
rf_att_20      &lt;- randomForest(party ~ ., data = train_att_20, ntree = 500, mtry = 2)
rf_att_prob_20 &lt;- predict(rf_att_20, test_att_20, type = &quot;prob&quot;)[, &quot;Republican&quot;]
rf_att_pred_20 &lt;- predict(rf_att_20, test_att_20)

# LogReg demographics
log_demo_20      &lt;- glm(party ~ age + gender + race + education + region + income +
                          religion + church + marital + work_status + religion_important,
                        data = train_demo_20, family = binomial)
log_demo_prob_20 &lt;- predict(log_demo_20, test_demo_20, type = &quot;response&quot;)
log_demo_pred_20 &lt;- factor(ifelse(log_demo_prob_20 &gt; 0.5, &quot;Republican&quot;, &quot;Democrat&quot;),
                           levels = levels(test_demo_20$party))

# RF demographics
rf_demo_20      &lt;- randomForest(party ~ age + gender + race + education + region + income +
                                  religion + church + marital + work_status + religion_important,
                                data = train_demo_20, ntree = 500)
rf_demo_prob_20 &lt;- predict(rf_demo_20, test_demo_20, type = &quot;prob&quot;)[, &quot;Republican&quot;]
rf_demo_pred_20 &lt;- predict(rf_demo_20, test_demo_20)

# Confusion matrices
cat(&quot; CONFUSION MATRICES (2020s) \n\n&quot;)</code></pre>

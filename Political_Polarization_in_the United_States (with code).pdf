<pre><code>## Warning: Removed 2 rows containing missing values or values outside the scale range
## (`geom_line()`).</code></pre>
<pre><code>## Warning: Removed 2 rows containing missing values or values outside the scale range
## (`geom_point()`).</code></pre>
<p><img role="img" src="data:image/png;base64," width="672" /></p>
<p>Over the past 70 years, there has been a big shift in how different
regions in the U.S. vote. The South used to be mostly Democratic but has
become strongly Republican since the 1990s, largely because of the Civil
Rights Act. In contrast, the Northeast has changed from competitive to
mainly Democratic. This shows that national politics are becoming more
important than local voting habits.</p>
<pre class="r"><code>ideology_time &lt;- data_model %&gt;%
  filter(!is.na(ideology), !is.na(party)) %&gt;%
  mutate(period = floor(year / 10) * 10) %&gt;%
  group_by(period, party) %&gt;%
  summarise(mean_ideology = mean(ideology, na.rm = TRUE),
            n = n(), .groups = &quot;drop&quot;)

ggplot(ideology_time, aes(x = period, y = mean_ideology, color = party)) +
  geom_line(linewidth = 1.2) +
  geom_point(size = 2.5) +
  scale_color_manual(values = party_colors) +
  scale_y_continuous(limits = c(1, 7), 
                     breaks = 1:7,
                     labels = c(&quot;Extremely\nLiberal&quot;, &quot;Liberal&quot;, &quot;Slightly\nLiberal&quot;, 
                                &quot;Moderate&quot;, &quot;Slightly\nConserv.&quot;, &quot;Conserv.&quot;, 
                                &quot;Extremely\nConserv.&quot;)) +
  labs(title = &quot;Ideological Divergence Between Parties&quot;,
       subtitle = &quot;Mean self-placement on liberal-conservative scale&quot;,
       x = &quot;&quot;, y = &quot;&quot;, color = &quot;&quot;) +
  theme_party</code></pre>
<p><img role="img" src="data:image/png;base64," width="672" /></p>
<p>The ideological divergence chart shows that political polarization
has increased over time. In the 1970s, Democrats identified as
“Moderate” and Republicans as “Slightly Conservative,” indicating a
small gap between the two. By the 2020s, Democrats have moved to
“Slightly Liberal,” while Republicans have become more “Conservative.”
This trend supports the <span class="citation">Abramowitz and Saunders
(2008)</span>’s idea of partisan sorting, meaning people are aligning
more closely with their party’s values. It’s important to note that this
chart reflects self-placement on a single dimension; the machine
learning models below use issue-specific attitudes to assess
<em>actual</em> sorting behavior, not just self-identification.</p>
<pre class="r"><code>data_clean %&gt;%
  dplyr::select(year, therm_dem_party, therm_rep_party) %&gt;%
  group_by(year) %&gt;%
  summarise(
    dem_available = mean(!is.na(therm_dem_party)) * 100,
    rep_available = mean(!is.na(therm_rep_party)) * 100,
    n = n()
  ) %&gt;%
  filter(dem_available &gt; 0) %&gt;%
  print(n = 30)</code></pre>
<pre><code>## # A tibble: 18 × 4
##     year dem_available rep_available     n
##    &lt;dbl&gt;         &lt;dbl&gt;         &lt;dbl&gt; &lt;int&gt;
##  1  1978          88.5          88.3  2304
##  2  1980          94.0          93.7  1614
##  3  1982          95.3          95.1  1418
##  4  1984          94.6          95.0  2257
##  5  1986          94.8          95.0  2176
##  6  1988          94.4          94.6  2040
##  7  1990          93.9          93.9  1980
##  8  1992          95.9          96.0  2485
##  9  1994          98.1          97.8  1795
## 10  1996          98.4          98.0  1714
## 11  1998          97.8          97.2  1281
## 12  2000          96.7          96.3  1807
## 13  2004          97.2          97.0  1212
## 14  2008          97.3          97.0  2322
## 15  2012          99.0          98.9  5914
## 16  2016          98.4          98.0  4270
## 17  2020          98.5          98.3  8280
## 18  2024          99.5          99.5  5521</code></pre>
<pre class="r"><code>therm_df &lt;- data %&gt;%
  dplyr::select(VCF0004, VCF0301, VCF0218, VCF0224) %&gt;%
  rename(
    year = VCF0004,
    partyid = VCF0301,
    therm_dem_party = VCF0218,
    therm_rep_party = VCF0224
  )</code></pre>
<pre class="r"><code>therm_long &lt;- therm_df %&gt;%
  filter(!is.na(partyid)) %&gt;%
  mutate(
    party3 = case_when(
      partyid %in% 1:2 ~ &quot;Democrat&quot;,
      partyid %in% 3:5 ~ &quot;Independent&quot;,
      partyid %in% 6:7 ~ &quot;Republican&quot;
    ),
    therm_dem_party = ifelse(therm_dem_party &gt; 100, NA, therm_dem_party),
    therm_rep_party = ifelse(therm_rep_party &gt; 100, NA, therm_rep_party)
  ) %&gt;%
  filter(!is.na(party3), year &gt;= 1978) %&gt;%
  group_by(year, party3) %&gt;%
  summarise(
    outparty_therm = case_when(
      first(party3) == &quot;Democrat&quot; ~ mean(therm_rep_party, na.rm=TRUE),
      first(party3) == &quot;Republican&quot; ~ mean(therm_dem_party, na.rm=TRUE),
      first(party3) == &quot;Independent&quot; ~ mean(c(therm_dem_party, 
                                               therm_rep_party), na.rm=TRUE)
    ),
    .groups = &quot;drop&quot;
  )</code></pre>
<p>Beyond demographic sorting, scholars have increasingly drawn
attention to a parallel phenomenon: the rise of affective polarization,
or growing emotional hostility between partisan groups. Unlike
ideological polarization, which concerns what people believe, affective
polarization concerns how people feel about those on the other side
<span class="citation">(Iyengar et al. 2019)</span>.</p>
<pre class="r"><code>ggplot(therm_long %&gt;% filter(party3 != &quot;Independent&quot;),
       aes(x = year, y = outparty_therm,
           color = party3, group = party3)) +
  geom_line(size = 1.2) +
  geom_point(size = 2) +
  scale_color_manual(values = c(&quot;Democrat&quot; = &quot;#2171b5&quot;,
                                &quot;Republican&quot; = &quot;#cb181d&quot;)) +
  scale_x_continuous(breaks = seq(1978, 2024, by = 4)) +
  labs(
    title = &quot;Affective Polarization in the United States (1978–2024)&quot;,
    subtitle = &quot;Mean feeling thermometer toward the OPPOSING party\nLower score = more hostility&quot;,
    x = NULL,
    y = &quot;Mean Feeling Thermometer (0-100)&quot;,
    color = &quot;Party&quot;
  ) +
  theme_minimal(base_size = 12) +
  theme(
    legend.position = &quot;top&quot;,
    axis.text.x = element_text(angle = 45, hjust = 1)
  )</code></pre>
<pre><code>## Warning: Using `size` aesthetic for lines was deprecated in ggplot2 3.4.0.
## ℹ Please use `linewidth` instead.
## This warning is displayed once every 8 hours.
## Call `lifecycle::last_lifecycle_warnings()` to see where this warning was
## generated.</code></pre>
<pre><code>## Warning: Removed 2 rows containing missing values or values outside the scale range
## (`geom_point()`).</code></pre>
<p><img role="img" src="data:image/png;base64," width="672" /></p>
<p>Research shows that feelings toward the opposing political party have
declined sharply since the late 1970s. Ratings that Democrats give to
Republicans and those Republicans give to Democrats have both dropped
steadily for the past 40 years, reaching very low levels by the 2020s.
This trend aligns with what <span class="citation">Iyengar et al.
(2019)</span> describes as affective polarization: Americans are not
necessarily more extreme in their policy views, but they have become
more hostile toward the other party. The decline sped up after the
mid-1990s, around the time of partisan shifts in religion and education.
There is no indication that this trend will change by 2024. The
emotional gap between the two parties has widened almost perfectly,
suggesting that as party identities have become stronger, feelings of
distance between the parties have also grown. There is no data for 2002
due to a lack of thermometer items in that survey.</p>
<pre class="r"><code>therm_df %&gt;%
  filter(year %in% 1996:2006) %&gt;%
  group_by(year) %&gt;%
  summarise(
    n = n(),
    dem_valid = sum(!is.na(therm_dem_party) &amp; therm_dem_party &lt;= 100),
    rep_valid = sum(!is.na(therm_rep_party) &amp; therm_rep_party &lt;= 100)
  )</code></pre>
<pre><code>## # A tibble: 5 × 4
##    year     n dem_valid rep_valid
##   &lt;int&gt; &lt;int&gt;     &lt;int&gt;     &lt;int&gt;
## 1  1996  1714      1714      1714
## 2  1998  1281      1281      1281
## 3  2000  1807      1807      1807
## 4  2002  1511         0         0
## 5  2004  1212      1212      1212</code></pre>
<pre class="r"><code>library(caret)</code></pre>
<pre><code>## Loading required package: lattice</code></pre>
<pre class="r"><code>demographic_vars &lt;- c(&quot;age&quot;, &quot;gender&quot;, &quot;race&quot;, &quot;education&quot;, &quot;region&quot;, 
                      &quot;income&quot;, &quot;religion&quot;, &quot;church&quot;)

attitude_vars &lt;- c(&quot;gov_health_insurance&quot;, &quot;gov_jobs&quot;, &quot;aid_black&quot;,
                   &quot;abortion&quot;, &quot;gov_spending&quot;, &quot;env_regulation&quot;, 
                   &quot;defense_spending&quot;, &quot;affirmative_action&quot;,
                   &quot;protect_homosexuals&quot;, &quot;gay_adoption&quot;, &quot;death_penalty&quot;,
                   &quot;immigration&quot;, &quot;religion_important&quot;, &quot;bible_authority&quot;,
                   &quot;moral_adjust&quot;, &quot;traditional_values&quot;,
                   &quot;black_conditions&quot;, &quot;black_no_favors&quot;, 
                   &quot;black_try_harder&quot;, &quot;black_gotten_less&quot;,
                   &quot;equal_opportunity&quot;, &quot;not_problem_unequal&quot;,
                   &quot;worry_less_equality&quot;, &quot;fewer_problems_equal&quot;)

all_vars &lt;- c(demographic_vars, attitude_vars)

decades &lt;- c(&quot;1980s&quot;, &quot;1990s&quot;, &quot;2000s&quot;, &quot;2010s&quot;, &quot;2020s&quot;)

set.seed(123)
results &lt;- data.frame()

for (dec in decades) {
  
  subset_full &lt;- data_model %&gt;% filter(decade == dec)
  
  for (model_type in c(&quot;Demographics&quot;, &quot;Attitudes&quot;)) {
    
    candidate_vars &lt;- switch(model_type,
      &quot;Demographics&quot; = demographic_vars,
      &quot;Attitudes&quot; = attitude_vars
    )
    
    available &lt;- candidate_vars[sapply(candidate_vars, function(v) {
      mean(!is.na(subset_full[[v]])) &gt; 0.3
    })]
    
    if (length(available) &lt; 3) next
    
    subset &lt;- subset_full %&gt;%
      dplyr::select(party, all_of(available)) %&gt;%
      drop_na()
    
    if (nrow(subset) &lt; 100) next
    
    train_idx &lt;- createDataPartition(subset$party, p = 0.7, list = FALSE)
    train &lt;- subset[train_idx, ]
    test &lt;- subset[-train_idx, ]
    
    model &lt;- glm(party ~ ., data = train, family = binomial)
    
    pred_prob &lt;- predict(model, newdata = test, type = &quot;response&quot;)
    pred_class &lt;- ifelse(pred_prob &gt; 0.5, &quot;Republican&quot;, &quot;Democrat&quot;)
    accuracy &lt;- mean(pred_class == test$party)
    
    results &lt;- rbind(results, data.frame(
      decade = dec,
      model_type = model_type,
      accuracy = round(accuracy * 100, 1),
      n_train = nrow(train),
      n_test = nrow(test),
      n_predictors = length(available),
      predictors_used = paste(available, collapse = &quot;, &quot;)
    ))
  }
}

head(results %&gt;%  dplyr::select(-predictors_used), 20)</code></pre>

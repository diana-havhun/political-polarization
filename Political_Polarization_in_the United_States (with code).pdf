<div id="random-forest-with-mice" class="section level3">
<h3>Random Forest with MICE</h3>
<pre class="r"><code>set.seed(123)
rf_results_att &lt;- data.frame()
for (dec in decades) {
  
  subset_raw &lt;- data_ml %&gt;%
    filter(decade == dec) %&gt;%
    select(party, all_of(attitude_vars_clean)) %&gt;%
    filter(!is.na(party))
  
  imp &lt;- mice(subset_raw, m = 5, maxit = 10, method = &quot;pmm&quot;,
              seed = 123, printFlag = FALSE)
  
  acc_all &lt;- c()
  f1_all &lt;- c()
  auc_all &lt;- c()
  
  for (i in 1:5) {
    data_imp &lt;- complete(imp, i)
    
    train_idx &lt;- createDataPartition(data_imp$party, p = 0.7, list = FALSE)
    train &lt;- data_imp[train_idx, ]
    test  &lt;- data_imp[-train_idx, ]
    
    rf_model &lt;- randomForest(party ~ ., data = train, ntree = 500, mtry = 2, importance = TRUE)
    pred_rf &lt;- predict(rf_model, newdata = test)
    rf_prob &lt;- predict(rf_model, newdata = test, type = &quot;prob&quot;)[, &quot;Republican&quot;]
    
    cm &lt;- confusionMatrix(pred_rf, test$party, positive = &quot;Republican&quot;)
    auc_val &lt;- auc(roc(as.numeric(test$party == &quot;Republican&quot;), rf_prob, quiet = TRUE))
    
    acc_all &lt;- c(acc_all, cm$overall[&quot;Accuracy&quot;])
    f1_all &lt;- c(f1_all, cm$byClass[&quot;F1&quot;])
    auc_all &lt;- c(auc_all, as.numeric(auc_val))
  }
  
  rf_results_att &lt;- rbind(rf_results_att, data.frame(
    decade = dec, model = &quot;Random Forest&quot;,
    accuracy = round(mean(acc_all) * 100, 1),
    f1 = round(mean(f1_all) * 100, 1),
    auc = round(mean(auc_all) * 100, 1),
    n_total = nrow(subset_raw)
  ))
}
rownames(rf_results_att) &lt;- NULL
knitr::kable(rf_results_att)</code></pre>

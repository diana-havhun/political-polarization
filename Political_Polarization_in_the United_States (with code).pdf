<div id="model-accuracy-comparison-attitudes-vs.-demographics-track" class="section level1">
<h1>Model Accuracy Comparison: Attitudes vs. Demographics Track (%)</h1>
<pre class="r"><code>subset_raw_20 &lt;- data_ml %&gt;%
  filter(decade == &quot;2020s&quot;) %&gt;%
  select(party, all_of(attitude_vars_clean)) %&gt;%
  filter(!is.na(party))

data_imp_20 &lt;- complete(mice(subset_raw_20, m = 1, maxit = 10,
                             method = &quot;pmm&quot;, seed = 123, printFlag = FALSE), 1)
set.seed(123)
idx_20        &lt;- createDataPartition(data_imp_20$party, p = 0.7, list = FALSE)
train_att_20  &lt;- data_imp_20[idx_20, ]
test_att_20   &lt;- data_imp_20[-idx_20, ]

subset_demo_20 &lt;- data_demo %&gt;% filter(decade == &quot;2020s&quot;)
set.seed(123)
idx2_20       &lt;- createDataPartition(subset_demo_20$party, p = 0.7, list = FALSE)
train_demo_20 &lt;- subset_demo_20[idx2_20, ]
test_demo_20  &lt;- subset_demo_20[-idx2_20, ]

log_att_20      &lt;- glm(party ~ ., data = train_att_20, family = binomial)
log_att_pred_20 &lt;- factor(ifelse(predict(log_att_20, test_att_20, type = &quot;response&quot;) &gt; 0.5,
                                 &quot;Republican&quot;, &quot;Democrat&quot;), levels = levels(test_att_20$party))

rf_att_20      &lt;- randomForest(party ~ ., data = train_att_20, ntree = 500, mtry = 2)
rf_att_pred_20 &lt;- predict(rf_att_20, test_att_20)

log_demo_20      &lt;- glm(party ~ age + gender + race + education + region + income +
                          religion + church + marital + work_status + religion_important,
                        data = train_demo_20, family = binomial)
log_demo_pred_20 &lt;- factor(ifelse(predict(log_demo_20, test_demo_20, type = &quot;response&quot;) &gt; 0.5,
                                  &quot;Republican&quot;, &quot;Democrat&quot;), levels = levels(test_demo_20$party))

rf_demo_20      &lt;- randomForest(party ~ age + gender + race + education + region + income +
                                  religion + church + marital + work_status + religion_important,
                                data = train_demo_20, ntree = 500)
rf_demo_pred_20 &lt;- predict(rf_demo_20, test_demo_20)

cm_summary &lt;- data.frame(
  Decade = c(&quot;1980s&quot;, &quot;1980s&quot;, &quot;1980s&quot;, &quot;1980s&quot;,
             &quot;2020s&quot;, &quot;2020s&quot;, &quot;2020s&quot;, &quot;2020s&quot;),
  Track = c(&quot;Attitudes&quot;, &quot;Attitudes&quot;, &quot;Demographics&quot;, &quot;Demographics&quot;,
            &quot;Attitudes&quot;, &quot;Attitudes&quot;, &quot;Demographics&quot;, &quot;Demographics&quot;),
  Model = rep(c(&quot;Logistic Regression&quot;, &quot;Random Forest&quot;), 4),
  Accuracy = c(
    round(mean(log_att_pred_80 == test_att_80$party) * 100, 1),
    round(mean(rf_att_pred_80  == test_att_80$party) * 100, 1),
    round(mean(log_demo_pred_80 == test_demo_80$party) * 100, 1),
    round(mean(rf_demo_pred_80  == test_demo_80$party) * 100, 1),
    round(mean(log_att_pred_20 == test_att_20$party) * 100, 1),
    round(mean(rf_att_pred_20  == test_att_20$party) * 100, 1),
    round(mean(log_demo_pred_20 == test_demo_20$party) * 100, 1),
    round(mean(rf_demo_pred_20  == test_demo_20$party) * 100, 1)
  )
)

knitr::kable(cm_summary, caption = &quot;Model Accuracy by Decade, Track, and Algorithm (%)&quot;)</code></pre>

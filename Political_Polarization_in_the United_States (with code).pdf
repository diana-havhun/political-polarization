<pre class="r"><code># Check number of trees — attitudes RF  
plot(rf_model, main = &quot;RF Error by Number of Trees (Attitudes)&quot;)</code></pre>
<p><img role="img" src="data:image/png;base64," width="672" /></p>
<p>The plot above shows the out-of-bag error rate as a function of the
number of trees, using the 2020s decade as a representative example. The
error curve flattens well before 500 trees, confirming that ntree = 500
is a sufficient and stable choice. Increasing the number of trees
further would not meaningfully improve model performance.</p>
<pre class="r"><code># ROC CURVES + CONFUSION MATRIX: 1980s 

library(pROC)

# Attitudes models (2020s)
subset_raw_80 &lt;- data_ml %&gt;%
  filter(decade == &quot;1980s&quot;) %&gt;%
  select(party, all_of(attitude_vars_clean)) %&gt;%
  filter(!is.na(party))

data_imp_80 &lt;- complete(mice(subset_raw_80, m = 1, maxit = 10,
                             method = &quot;pmm&quot;, seed = 123, printFlag = FALSE), 1)
set.seed(123)
idx_80       &lt;- createDataPartition(data_imp_80$party, p = 0.7, list = FALSE)
train_att_80 &lt;- data_imp_80[idx_80, ]
test_att_80  &lt;- data_imp_80[-idx_80, ]

# Demographics models (1980s)
subset_demo_80 &lt;- data_demo %&gt;% filter(decade == &quot;1980s&quot;)

set.seed(123)
idx2_80      &lt;- createDataPartition(subset_demo_80$party, p = 0.7, list = FALSE)
train_demo_80 &lt;- subset_demo_80[idx2_80, ]
test_demo_80  &lt;- subset_demo_80[-idx2_80, ]

# LogReg attitudes
log_att_80      &lt;- glm(party ~ ., data = train_att_80, family = binomial)
log_att_prob_80 &lt;- predict(log_att_80, test_att_80, type = &quot;response&quot;)
log_att_pred_80 &lt;- factor(ifelse(log_att_prob_80 &gt; 0.5, &quot;Republican&quot;, &quot;Democrat&quot;),
                          levels = levels(test_att_80$party))

# RF attitudes
rf_att_80      &lt;- randomForest(party ~ ., data = train_att_80, ntree = 500, mtry = 2)
rf_att_prob_80 &lt;- predict(rf_att_80, test_att_80, type = &quot;prob&quot;)[, &quot;Republican&quot;]
rf_att_pred_80 &lt;- predict(rf_att_80, test_att_80)

# LogReg demographics
log_demo_80      &lt;- glm(party ~ age + gender + race + education + region + income +
                          religion + church + marital + work_status + religion_important,
                        data = train_demo_80, family = binomial)
log_demo_prob_80 &lt;- predict(log_demo_80, test_demo_80, type = &quot;response&quot;)
log_demo_pred_80 &lt;- factor(ifelse(log_demo_prob_80 &gt; 0.5, &quot;Republican&quot;, &quot;Democrat&quot;),
                           levels = levels(test_demo_80$party))

# RF demographics
rf_demo_80      &lt;- randomForest(party ~ age + gender + race + education + region + income +
                                  religion + church + marital + work_status + religion_important,
                                data = train_demo_80, ntree = 500)
rf_demo_prob_80 &lt;- predict(rf_demo_80, test_demo_80, type = &quot;prob&quot;)[, &quot;Republican&quot;]
rf_demo_pred_80 &lt;- predict(rf_demo_80, test_demo_80)

# Confusion matrices
cat(&quot; CONFUSION MATRICES (1980s) \n\n&quot;)</code></pre>
<pre><code>##  CONFUSION MATRICES (1980s)</code></pre>
<pre class="r"><code>print_cm_short &lt;- function(label, pred, actual) {
  cm &lt;- confusionMatrix(pred, actual, positive = &quot;Republican&quot;)
  cat(label, &quot;\n&quot;)
  print(cm$table)
  cat(&quot;Accuracy:&quot;, round(cm$overall[&quot;Accuracy&quot;], 4),
      &quot;| 95% CI: (&quot;, round(cm$overall[&quot;AccuracyLower&quot;], 4),
      &quot;,&quot;, round(cm$overall[&quot;AccuracyUpper&quot;], 4), &quot;)\n&quot;)
  cat(&quot;No Information Rate:&quot;, round(cm$overall[&quot;AccuracyNull&quot;], 4),
      &quot;| P-Value [Acc &gt; NIR]:&quot;, format.pval(cm$overall[&quot;AccuracyPValue&quot;]), &quot;\n\n&quot;)
}

print_cm_short(&quot;Attitudes: Logistic Regression&quot;, log_att_pred_80, test_att_80$party)</code></pre>

set.seed(123)
idx2_20      &lt;- createDataPartition(subset_demo_20$party, p = 0.7, list = FALSE)
train_demo_20 &lt;- subset_demo_20[idx2_20, ]
test_demo_20  &lt;- subset_demo_20[-idx2_20, ]

# LogReg attitudes
